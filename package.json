  "description": "Diplom va sertifikatlarni blockchain orqali yaratish, tekshirish va ulash tizimi",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "build": "npm run compile && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "chain": "npx --yes ganache@7.9.2 --chain.chainId 1337 --wallet.totalAccounts 10 --wallet.defaultBalance 1000 --server.host 127.0.0.1 --server.port 8545",
